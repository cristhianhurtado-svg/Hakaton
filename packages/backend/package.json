    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "pg": "^8.13.0",
    "ioredis": "^5.4.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "winston": "^3.14.2",
