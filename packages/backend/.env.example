# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=conecta2
DB_USER=conecta2
DB_PASSWORD=conecta2_dev
DB_SSL=false
DB_MAX_CONNECTIONS=20

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT / Auth ──────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d
IDP_ISSUER=https://idp.segurosbolivar.com
IDP_JWKS_URI=https://idp.segurosbolivar.com/.well-known/jwks.json

# ─── Encryption ─────────────────────────────────────────────
ENCRYPTION_KEY=dev-encryption-key-32-chars-long!

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:5173

# ─── AWS (optional for local dev) ────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=conecta2-artifacts
SES_FROM_EMAIL=noreply@conecta2.segurosbolivar.com

# ─── Legacy SOAP Services ───────────────────────────────────
LEGACY_SOAP_BASE_URL=http://localhost:8080/soap
LEGACY_TIMEOUT=10000
